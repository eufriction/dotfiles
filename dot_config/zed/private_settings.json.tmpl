// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "left",
    "enable_feedback": false,
    {{- if .work.enable }}
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.4-mini",
    },
    {{- else }}
    "inline_assistant_model": {
      "provider": "mistral",
      "model": "codestral-latest"
    },
    {{- end }}
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
    {{- if .work.enable }}
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    {{- else }}
      "provider": "mistral",
      "model": "devstral-small-latest"
    {{- end }}
    },
    "default_profile": "write",
    "notify_when_agent_waiting": "primary_screen",
    "show_turn_stats": true,
    "thinking_display": "auto",
    {{- if .work.enable }}
    "thread_summary_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.4",
    },
    {{- end }}
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "mcp:mcp-server-github:search_pull_requests": {
          "default": "allow"
        },
        "mcp:mcp-server-github:get_file_contents": {
          "default": "allow"
        },
        "mcp:mcp-server-github:search_code": {
          "default": "allow"
        },
        "mcp:mcp-server-github:list_branches": {
          "default": "allow"
        },
        "move_path": {
          "default": "allow"
        },
        "save_file": {
          "default": "allow"
        },
        "restore_file_from_disk": {
          "default": "allow"
        },
        "mcp:mcp-server-github:pull_request_read": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "mcp:mcp-server-github:issue_read": {
          "default": "allow"
        },
        "mcp:mcp-server-github:search_issues": {
          "default": "allow"
        },
        "copy_path": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            {
              "pattern": "^docker\\s+(build|image|images|info|inspect|logs|ps|run|version)(\\s|$)"
            },
            {
              "pattern": "^docker\\s+compose\\s+(up|down|logs|ps|exec|build|config)(\\s|$)"
            },
            {
              "pattern": "^(\\w+=\\S+\\s+)*go\\s+(build|clean|doc|env|fmt|generate|get|list|mod|run|test|tool|version|vet)(\\s|$)"
            },
            {
              "pattern": "^go\\s+mod\\s+(tidy|vendor|download|verify)(\\s|$)"
            },
            {
              "pattern": "^(gofmt|golangci-lint)\\b"
            },
            {
              "pattern": "^npm\\s+(install|test|run)"
            },
            {
              "pattern": "^git\\s+(add|autosquash|branch|checkout|describe|diff|fetch|fixup|grep|log|ls-files|ls-remote|merge-base|mv|pop|rev-list|rev-parse|show|stash|status)(\\s|$)"
            },
            {
              "pattern": "^git\\s+remote(\\s+(show|get-url)\\s|\\s*$|-v)"
            },
            {
              "pattern": "^(awk|bc|cat|cd|chmod|cp|diff|echo|find|grep|head|jq|ls|make|mkdir|printf|ps|pwd|readlink|sed|sleep|sort|tail|tee|uniq|wc|which|yamlfmt|yq)\\b"
            },
            {
              "pattern": "^git\\s+.+\\s+(branch|diff|log|grep|remote|show|status)\\b"
            },
            {
              "pattern": "^helm\\s+(lint|list|template|unittest)"
            },
            {
              "pattern": "^kubectl\\s+(api-resources|api-versions|cluster-info|describe|events|get|kustomize|logs|rollout|wait)\\b"
            },
            {
              "pattern": "^kind\\s+(get|load|version)\\s+"
            },
            {
              "pattern": "^(\\w+=\\S+\\s+)*mise\\s+(env|settings|run|tasks|version)(\\s|$)"
            },
            {
              "pattern": "^cilium\\s+(help|hubble|status|version)(\\s|$)"
            },
          ],
          "always_confirm": [
            {
              "pattern": "^(pip|pip3|pipx)"
            },
            {
              "pattern": "^npx(\\s|$)"
            },
            {
              "pattern": "sudo\\s+/"
            },
            {
              "pattern": "^git\\s+(commit|merge|push)"
            },
            {
              "pattern": "^git\\s+branch\\s+.*-[dD]"
            }
          ]
        },
      },
    },
    "use_modifier_to_send": true,
  },
  "agent_buffer_font_size": 12.0,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
    },
    {{- if not .work.enable }}
    "Mistral Vibe": {
      "type": "custom",
      "command": "vibe-acp",
      "args": [],
      "env": {}
    }
    {{- end }}
  },
  "agent_ui_font_size": 13.0,
  "auto_install_extensions": {
    "helm": true,
    "html": true,
    "toml": true,
    "vale": true,
  },
  "autosave": "on_focus_change",
  "buffer_font_size": 13.0,
  "buffer_line_height": "comfortable",
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "context_servers": {},
  "diff_view_style": "unified",
  "edit_predictions": {
  {{- if .work.enable }}
    "provider": "copilot",
  {{- else }}
    "provider": "codestral",
  {{- end }}
    "mode": "subtle",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
    ],
  },
  "git_panel": {
    "dock": "right",
    "sort_by_path": true,
    "tree_view": true,
  },
  "helix_mode": true,
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "devstral:latest",
          "display_name": "devstral",
          "max_tokens": 32768,
          "supports_tools": true,
        },
      ],
    },
  },
  "languages": {
    "Go": {
      "enable_language_server": true,
      "language_servers": [
        "gopls",
      ],
    },
    "Helm": {
      "enable_language_server": true,
      "language_servers": [
        "helm",
        "yaml-language-server",
      ],
    },
    "Markdown": {
      "enable_language_server": true,
      "formatter": "prettier",
      "format_on_save": "on",
      "language_servers": [
        "markdown-oxide",
        "vale",
      ],
    },
  },
  "lsp": {
    "gopls": {
      "binary": {
        "path": "gopls",
      },
      "settings": {
        "codelenses": {
          "run_govulncheck": true,
        },
      },
      "initialization_options": {
        "gofumpt": true,
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
        "semanticTokens": true,
        "staticcheck": true,
        "usePlaceholders": true,
        "vulncheck": "Imports",
      },
    },
    "helm": {
      "settings": {
        "helm-ls": {
          "yamlls": {
            "enabled": false,
          },
        },
      },
    },
    "vale": {
      "binary": {
        "path": "vale-ls",
      },
      "initialization_options": {
        "syncOnStartup": true,
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true,
          },
        },
      },
    },
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "macos": {
    "use_system_window_tabs": false,
  },
  "node": {
    "ignore_system_version": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "preferred_line_length": 120,
  "prettier": {
    "allowed": true,
  },
  "project_panel": {
    "dock": "right",
    "hide_hidden": false,
  },
  "semantic_tokens": "combined",
  "soft_wrap": "bounded",
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "terminal": {
    "copy_on_select": true,
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "system",
  },
  "ui_font_size": 13.0,
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 700,
  },
}
