// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "left",
    "enable_feedback": false,
    {{- if .work.enable }}
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
    },
    {{- else }}
    "inline_assistant_model": {
      "provider": "mistral",
      "model": "codestral-latest"
    },
    {{- end }}
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
    {{- if .work.enable }}
      "provider": "openai-subscribed",
      "model": "gpt-6-luna",
    {{- else }}
      "provider": "mistral",
      "model": "devstral-small-latest"
    {{- end }}
    },
    "default_profile": "write",
    "notify_when_agent_waiting": "primary_screen",
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev"
      ],
      "allow_unsandboxed": false,
      "write_paths": [
        "{{- .chezmoi.homeDir }}/Library/Caches/go-build",
        {
          "requested": "{{- .chezmoi.homeDir }}/go/pkg/mod",
          "resolved": "{{- .chezmoi.homeDir }}/go/pkg/mod"
        }
      ]
    },
    "show_turn_stats": true,
    "thinking_display": "auto",
    {{- if .work.enable }}
    "thread_summary_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.4",
    },
    {{- end }}
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "terminal": {
          "default": "allow",
          "always_confirm": [
            {
              "pattern": "^(pip|pip3|pipx)"
            },
            {
              "pattern": "^npx(\\s|$)"
            },
            {
              "pattern": "\\bsudo\\b"
            },
            {
              "pattern": "\\bgit\\b.*\\b(commit|merge|push)\\b"
            },
            {
              "pattern": "\\bgit\\b.*\\bbranch\\b.*\\s(-[dD]|--delete)(\\s|=|$)"
            },
            {
              "pattern": "\\bgh\\s+api\\b"
            },
            {
              "pattern": "\\b(GITHUB_TOKEN|GH_TOKEN)\\b"
            },
            {
              "pattern": "\\bgh\\s+auth\\s+token\\b"
            },
            {
              "pattern": "(\\.ssh|\\.aws|\\.azure|\\.kube|\\.docker|\\.gnupg)(/|\\b)|\\.config/(gh|gcloud)(/|\\b)|\\.(netrc|git-credentials|npmrc)\\b"
            }
          ]
        },
      },
    },
    "use_modifier_to_send": true,
  },
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 13.0,
  "auto_install_extensions": {
    "helm": true,
    "html": true,
    "toml": true,
    "vale": true,
  },
  "autosave": "on_focus_change",
  "buffer_font_size": 13.0,
  "buffer_line_height": "comfortable",
  "cli_default_open_behavior": "new_window",
  "collaboration_panel": {
    "dock": "right"
  },
  "context_servers": {},
  "diff_view_style": "unified",
  "edit_predictions": {
    "allow_data_collection": "no",
  {{- if .work.enable }}
    "provider": "copilot",
  {{- else }}
    "provider": "codestral",
  {{- end }}
    "mode": "subtle",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
    ],
  },
  "git_panel": {
    "dock": "right",
    "sort_by_path": true,
    "tree_view": true,
  },
  "helix_mode": true,
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "devstral:latest",
          "display_name": "devstral",
          "max_tokens": 32768,
          "supports_tools": true,
        },
      ],
    },
  },
  "languages": {
    "Go": {
      "enable_language_server": true,
      "language_servers": [
        "gopls",
      ],
    },
    "Helm": {
      "enable_language_server": true,
      "language_servers": [
        "helm",
        "yaml-language-server",
      ],
    },
    "Markdown": {
      "enable_language_server": true,
      "formatter": "prettier",
      "format_on_save": "on",
      "language_servers": [
        "markdown-oxide",
        "vale",
      ],
    },
  },
  "lsp": {
    "gopls": {
      "binary": {
        "path": "gopls",
      },
      "settings": {
        "codelenses": {
          "run_govulncheck": true,
        },
      },
      "initialization_options": {
        "gofumpt": true,
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
        "semanticTokens": true,
        "staticcheck": true,
        "usePlaceholders": true,
        "vulncheck": "Imports",
      },
    },
    "helm": {
      "settings": {
        "helm-ls": {
          "yamlls": {
            "enabled": false,
          },
        },
      },
    },
    "vale": {
      "binary": {
        "path": "vale-ls",
      },
      "initialization_options": {
        "syncOnStartup": true,
      },
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true,
          },
        },
      },
    },
  },
  "format_on_save": "on",
  "formatter": "language_server",
  "macos": {
    "use_system_window_tabs": false,
  },
  "node": {
    "ignore_system_version": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "preferred_line_length": 120,
  "prettier": {
    "allowed": true,
  },
  "project_panel": {
    "dock": "right",
    "hide_hidden": false,
  },
  "semantic_tokens": "combined",
  "soft_wrap": "bounded",
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "terminal": {
    "copy_on_select": true,
    "cursor_shape": "bar",
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "Ayu Light",
    "mode": "system",
  },
  "ui_font_size": 13.0,
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 700,
  },
}
